    <section id="plugin.video.bacterio">

        <!-- ======================== PLAYBACK ======================== -->
        <category id="playback" label="Playback">
            <group id="1" label="Playback">
                <setting id="playback.auto_play" type="boolean" label="Auto-play best source" help="Skip the source picker and automatically select the best available source.">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle" />
                </setting>
                <setting id="playback.quality_pref" type="integer" label="Quality preference" help="When auto-playing, prefer cached (fastest) or highest quality.">
                    <level>0</level>
                    <default>0</default>
                    <control type="spinner" format="integer">
                        <values>
                            <value label="Cached first (fastest)" />
                            <value label="Best quality (4K → SD)" />
                        </values>
                    </control>
                </setting>
            </group>
        </category>

        <!-- ======================== GENERAL ======================== -->
