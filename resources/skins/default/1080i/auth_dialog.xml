<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol always="true">100</defaultcontrol>
    <controls>
        <control type="group">
            <left>560</left>
            <top>140</top>
            <width>800</width>
            <height>800</height>
            <!-- Background -->
            <control type="image">
                <width>800</width>
                <height>800</height>
                <texture colordiffuse="FF1A1A1A">bacterio_common/white.png</texture>
            </control>
            <control type="group">
                <width>100%</width>
                <height>10%</height>
                <!-- Title bar -->
                <control type="image">
                    <texture colordiffuse="FF2D2D2D">bacterio_common/white.png</texture>
                </control>

                <!-- Addon icon -->
                <control type="image">
                    <centerleft>5%</centerleft>
                    <centertop>50%</centertop>
                    <width>45</width>
                    <height>45</height>
                    <align>right</align>
                    <aligny>top</aligny>
                    <texture>resources/media/addon_icons/minis/bacterio_icon.png</texture>
                    <aspectratio aligny="top">keep</aspectratio>
                </control>

                <!-- Title label -->
                <control type="label" id="3">
                    <left>50</left>
                    <centertop>50%</centertop>
                    <width>700</width>
                    <height>100%</height>
                    <font>font13</font>
                    <aligny>center</aligny>
                    <textcolor>ffffffff</textcolor>
                </control>
            </control>

            <control type="group">
                <top>10%</top>
                <height>90%</height>
                <!-- QR Code -->
                <control type="image" id="1">
                    <centerleft>50%</centerleft>
                    <width>400</width>
                    <height>400</height>
                    <aspectratio>keep</aspectratio>
                </control>

                <!-- Message label -->
                <control type="label" id="2">
                    <centerleft>50%</centerleft>
                    <top>450</top>
                    <height>200</height>
                    <align>center</align>
                    <font>font14</font>
                    <wrapmultiline>true</wrapmultiline>
                    <width max="600">auto</width>
                    <textcolor>ffffffff</textcolor>
                </control>

                <!-- Cancel button -->
                <control type="button" id="100">
                    <centerleft>50%</centerleft>
                    <top>600</top>
                    <width>200</width>
                    <height>100</height>
                    <label>Cancel</label>
                    <align>center</align>
                    <font>font13</font>
                    <textcolor>ffffffff</textcolor>
                    <focusedcolor>ffffffff</focusedcolor>
                </control>
            </control>
        </control>
    </controls>
</window>
