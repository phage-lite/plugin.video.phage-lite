{
    "venvPath": ".",
    "venv": ".venv",
    "pythonVersion": "3.11",
    "include": ["resources/lib"],
    "extraPaths": ["resources/lib"],
    "exclude": [
        "resources/lib/modules",
        "resources/lib/windows",
        "resources/lib/scrapers",
        "resources/lib/segno",
        "resources/lib/services/imdb.py"
    ],
    "allowedUntypedLibraries": ["sqlite3", "xbmc", "xbmcgui", "xbmcaddon", "xbmcplugin", "xbmcvfs"],
    "reportAny": "none",
    "reportExplicitAny": "none",
    "reportImplicitOverride": "none",
    "reportUntypedFunctionDecorator": "none"
}
